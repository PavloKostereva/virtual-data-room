# ---------------------------------------------------------------------------
# Local dev — copy to .env and fill in
# ---------------------------------------------------------------------------

# Postgres (local Docker or Supabase direct :5432 for migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dataroom?schema=public"

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_…"

# Supabase → API Keys → Secret — signup (auto-confirm) and `npm run db:seed`
SUPABASE_SERVICE_ROLE_KEY="sb_secret_…"

# Upload ticket signing (not login). Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------------------
# Vercel / production only (STORAGE_DRIVER=s3 is automatic on Vercel)
# S3 endpoint is derived from NEXT_PUBLIC_SUPABASE_URL — do not set manually.
# ---------------------------------------------------------------------------
# S3_BUCKET="vault"
# S3_REGION="eu-central-1"
# S3_ACCESS_KEY_ID="…"
# S3_SECRET_ACCESS_KEY="…"
